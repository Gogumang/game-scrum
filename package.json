{
  "name": "strum",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm check:story && react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "check:story": "node --experimental-strip-types scripts/check-story.mjs",
    "scenes:generate": "node scripts/generate-scenes.mjs",
    "check:ai": "node scripts/check-ai.mjs",
    "start:local": "node --env-file=.env.local ./node_modules/.bin/react-router-serve ./build/server/index.js",
    "scenes:sync": "node scripts/sync-scenes.mjs",
    "scenes:optimize": "node scripts/optimize-scenes.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.72",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.108",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/react-router": "^1.3.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.18.1"
}
