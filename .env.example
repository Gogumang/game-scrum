# ChatGPT(OpenAI) API — 팀 분석과 장면 그림 생성에 쓰입니다.
# 값은 편집기로 .env.local 에 직접 넣으세요. 터미널 기록에 남기지 마세요.
OPENAI_API_KEY=

# 모델을 바꾸고 싶을 때만 (기본값이 들어 있습니다)
# OPENAI_TEXT_MODEL=gpt-5.4
# OPENAI_IMAGE_MODEL=gpt-image-2

# 여러 기기가 같은 방을 보려면 필요합니다.
# `vercel integration add upstash/upstash-kv --no-claim` 후 `vercel env pull .env.local --yes`
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 진행자 비밀번호. 방을 열거나 진행자 자리를 이어받을 때 필요합니다.
# 배포 환경에서는 반드시 넣어야 합니다 (없으면 방을 열 수 없습니다).
# 개발 중에 비워두면 임시로 changeme 가 쓰입니다.
HOST_PASSWORD=
